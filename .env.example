# Copy to .env (which is gitignored) and fill in real values.
# Never commit .env.

# ─────────────────────────────────────────────────────────────────────────────
# Streamlock — Operator API key
# Issued via /admin/operators on the Streamlock app. Format: sk_<base64url>.
# Same key works on devnet + mainnet; the `STREAMLOCK_CHAIN` below picks which.
# ─────────────────────────────────────────────────────────────────────────────
STREAMLOCK_OPERATOR_KEY=sk_REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# Streamlock — chain + base URL
# Production: chain=mainnet, BASE_URL=https://www.streamlock.fun
# Devnet:     chain=soldev,  BASE_URL=https://www.streamlock.fun
# Local dev:  chain=soldev,  BASE_URL=http://localhost:3000 (against `npm run dev` in streamlockfun)
# ─────────────────────────────────────────────────────────────────────────────
STREAMLOCK_CHAIN=soldev
STREAMLOCK_BASE_URL=https://www.streamlock.fun

# ─────────────────────────────────────────────────────────────────────────────
# Solana — operator keypair (base64-encoded secret bytes)
# Generate with: solana-keygen new -o ./operator.json --no-bip39-passphrase
# Then encode:   cat ./operator.json | python3 -c 'import json,sys,base64; print(base64.b64encode(bytes(json.load(sys.stdin))).decode())'
#
# Funding: ~0.5 SOL working balance (per-match cost ~0.05 SOL, mostly refundable rent).
# ─────────────────────────────────────────────────────────────────────────────
OPERATOR_SECRET_KEY_B64=REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# Solana — RPC endpoint (used for broadcasting signed txs)
# Mainnet: use a paid RPC (Helius, Triton, QuickNode). Public endpoints are throttled.
# Devnet:  https://api.devnet.solana.com is fine for low-volume testing.
# ─────────────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com

# ─────────────────────────────────────────────────────────────────────────────
# Game — token mint that streams play against
# Either an existing token (e.g. $LOCK) or your own game-token's mint.
# ─────────────────────────────────────────────────────────────────────────────
GAME_TOKEN_MINT=REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# World ID — optional sybil gate for "verified players only" matches.
# Provisioned via the worldcoin-developer-portal MCP (see SKILL.md).
# Values are app-scoped; the signing key is server-only and rotates via the MCP.
# ─────────────────────────────────────────────────────────────────────────────
WORLD_APP_ID=app_REPLACE_ME
WORLD_RP_ID=rp_REPLACE_ME
WORLD_ACTION=play-rps
# staging = simulator (https://simulator.worldcoin.org); production = real World App.
WORLD_ENVIRONMENT=staging
# JWS-style signing key returned exactly once by configure_world_id. Server-only.
WORLD_SIGNING_KEY=REPLACE_ME
# Developer Portal team API key. Used by the MCP; not loaded by the server itself.
WORLD_API_KEY=api_REPLACE_ME
# 32+ random bytes used to HMAC-sign the wid_session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORLD_SESSION_SECRET=REPLACE_ME
