{
    "buildCommand": "cd web && npm install && npm run build",
    "outputDirectory": "web/dist",
    "framework": null,
    "rewrites": [
      { "source": "/api/(.*)", "destination": "https://streamlockfun-minigame.fly.dev/api/$1" },
      { "source": "/((?!api/|ws/).*)", "destination": "/index.html" }
    ]
}