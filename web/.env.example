# Privy app ID for wallet connection (external Solana wallets + embedded
# email/social wallets). Create an app at https://dashboard.privy.io and add
# your prod + localhost origins to its allowed origins. Copy this file to
# .env.local and fill in the value.
VITE_PRIVY_APP_ID=

# Optional: override the operator API base used by the Vite dev proxy.
# VITE_API_BASE=http://127.0.0.1:8787
