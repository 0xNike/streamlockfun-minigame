{
  "name": "streamlock-games",
  "version": "0.1.0",
  "private": true,
  "description": "Streamlock Games — games hub and games built on the Streamlock Operator SDK. Consumes @streamlock/operator-sdk only — no internal Streamlock imports — to demonstrate that the SDK is a real third-party integration boundary.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "match": "tsx src/main.ts",
    "cleanup": "tsx src/cleanup.ts",
    "server": "tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p .",
    "start": "node dist/server/index.js",
    "postinstall": "node scripts/patch-sdk.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/websocket": "^10.0.1",
    "@solana/web3.js": "^1.95.0",
    "@streamlock/operator-sdk": "^0.1.9",
    "@worldcoin/idkit-core": "^4.1.4",
    "better-sqlite3": "^11.3.0",
    "chess.js": "^1.4.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
